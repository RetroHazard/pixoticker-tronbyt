diff --git a/main/wifi.c b/main/wifi.c
index 09122d4..b15d8c7 100644
--- a/main/wifi.c
+++ b/main/wifi.c
@@ -118,6 +118,13 @@ int wifi_initialize(const char* ssid, const char* password) {
   // Configure STA with credentials if available
   if (has_credentials) {
     wifi_config_t sta_config = {0};
+#ifdef CONFIG_BOARD_PIXOTICKER
+    // Match the stock Pixoticker's saved security policy without forcing WPA2.
+    sta_config.sta.threshold.authmode = WIFI_AUTH_WPA2_PSK;
+    sta_config.sta.pmf_cfg.capable = true;
+    sta_config.sta.pmf_cfg.required = false;
+    sta_config.sta.sae_pwe_h2e = WPA3_SAE_PWE_BOTH;
+#endif
     nvs_get_ssid((char*)sta_config.sta.ssid, sizeof(sta_config.sta.ssid));
     nvs_get_password((char*)sta_config.sta.password,
                      sizeof(sta_config.sta.password));
