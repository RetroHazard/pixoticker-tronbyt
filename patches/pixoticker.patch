diff --git a/main/buffer_memory.h b/main/buffer_memory.h
new file mode 100644
index 0000000..71c018e
--- /dev/null
+++ b/main/buffer_memory.h
@@ -0,0 +1,11 @@
+#pragma once
+
+#include "esp_heap_caps.h"
+#include "sdkconfig.h"
+
+// Keep buffers in PSRAM on equipped boards and byte-addressable internal RAM otherwise.
+#ifdef CONFIG_SPIRAM
+#define BUFFER_MEMORY_CAPS (MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT)
+#else
+#define BUFFER_MEMORY_CAPS (MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT)
+#endif
